---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  difficulty?: string;
  challenge?: string;
}

const { title, description, pubDate, updatedDate, tags = [], difficulty, challenge } = Astro.props;

function formatDate(d: Date) {
  return d.toLocaleDateString('vi-VN', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---

<BaseLayout title={title} description={description} pubDate={pubDate}>
  <article class="post">
    <header class="post-header">
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <span class="muted"> · cập nhật {formatDate(updatedDate)}</span>
        )}
        {difficulty && <span class="badge">Độ khó: {difficulty}</span>}
        {challenge && <span class="badge badge-alt">{challenge}</span>}
      </p>
      <h1>{title}</h1>
      <p class="post-desc">{description}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer class="post-footer">
      <p class="muted">— musicsms</p>
      <p class="muted">
        Có sai sót hoặc muốn thảo luận? Mở issue trên{' '}
        <a href="https://github.com/musicsms/bopbap-blog" target="_blank" rel="noopener">GitHub</a>.
      </p>
    </footer>
  </article>
</BaseLayout>
